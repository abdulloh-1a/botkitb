# Bot tokeni (@BotFather dan oling)
BOT_TOKEN=123456789:PLACEHOLDER_TOKEN

# BITTA super admin Telegram ID si (@userinfobot yordamida bilib oling)
SUPER_ADMIN_ID=123456789

# SQLite bazasi yo'li (avtomatik yaratiladi)
DATABASE_PATH=data/bot.db

# Loglash (Render da ENABLE_FILE_LOG=false qilib, faqat stdout ga yozing)
LOG_LEVEL=INFO
LOG_FILE=bot.log
ENABLE_FILE_LOG=true

# Xabar yuborish orasidagi pauza (soniyada, flooding oldini olish uchun)
BROADCAST_DELAY=0.05

# Debug rejimi
DEBUG=False
